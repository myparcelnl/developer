{
  "extends": "@tsconfig/node18/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      // Our custom theme
      "@mptheme/*": [
        "src/.vuepress/theme/*"
      ],
      "@Public/*": [
        "src/.vuepress/public/*"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "vuepress/client-types",
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "*.cjs",
    "*.js",
    "*.mjs",
    "*.ts",
    "private/**/*",
    "src/**/*",
    "src/.vuepress/**/*",
    "test/**/*",
    "types/**/*"
  ],
  "exclude": [
    "**/.vuepress/.cache",
    "**/.vuepress/.temp",
    "**/.vuepress/dist",
    "**/node_modules"
  ]
}
